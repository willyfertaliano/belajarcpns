<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1565C0">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belajar CPNS"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Persiapan SKD • TWK • TIU • TKP"
            android:textColor="#E3F2FD"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Versi 2.0 • 100 soal + timer + nilai"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:paddingBottom="12dp"/>

            <Button
                android:id="@+id/btnTWK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇮🇩  Latihan TWK"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnTIU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🧠  Latihan TIU"
                android:textSize="16sp"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnTKP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤝  Latihan TKP"
                android:textSize="16sp"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥  Simulasi 100 Soal"
                android:textSize="16sp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Materi Singkat"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#263238"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TWK: Pancasila, UUD 1945, NKRI, Bhinneka Tunggal Ika, dan wawasan kebangsaan.\n\nTIU: Tes verbal, numerik, logika, dan analisis.\n\nTKP: Pelajari orientasi pelayanan, integritas, profesionalisme, kerja sama, dan pengambilan keputusan."
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textColor="#455A64"
                android:padding="14dp"
                android:background="#FFFFFF"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
